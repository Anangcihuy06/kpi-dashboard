# KPI Dashboard Environment Configuration

# Database Configuration (SQLite - currently using)
DATABASE_URL=sqlite:///./database.db

# Scheduler Intervals (in minutes)
SYNC_SPRINTS_INTERVAL_MINUTES=60
SYNC_KPI_CALCULATION_INTERVAL_MINUTES=60

# Worker concurrency (in-process thread pools)
KPI_CALC_WORKERS=5
SYNC_USER_WORKERS=3

# Cross-instance DB locks (TTL in minutes; used by KPI calc / data sync / rescore)
CALC_LOCK_TTL_MINUTES=360

# Auto-create unique constraints + query-path indexes on every startup/deploy
AUTO_INDEX=1

# Webhook trigger settings (trigger-driven worker)
# WEBHOOK_DEBOUNCE_MINUTES=5
# WEBHOOK_SECRET_GITLAB=<shared secret for X-Hub-Signature verification>
# WEBHOOK_SECRET_JIRA=<shared secret for X-Hub-Signature verification>

# Optional sync window cap. Leave 0 (default) to always sync the full requested
# range (year/2-day) so no record is ever skipped. Set to N>0 to limit each
# user sync to the last N days (biggest win for the hourly/full-year jobs, but
# only safe when the previous sync already captured history).
# SYNC_INCREMENTAL_WINDOW_DAYS=0

# LLM scoring throttle / budget (feature_analyzer.py)
# LLM_RPM=10
# LLM_MAX_ISSUES_PER_SYNC=500
# FEATURE_RULE_KEYWORDS_JSON={"routine": ["minor fix", "text change"], "scope": [...]}

# External API Settings (Optional - for development)
# JIRA_URL=https://your-jira-instance.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_BOARD_ID=1
# JIRA_TOKEN=your-jira-api-token

# GitLab Settings (Optional - for development)
# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN=your-gitlab-personal-access-token

# External HR System Settings
# TALENT_BACKEND_URL=https://talent-backend.andreasbilly.com

# HRIS system credentials used for background jobs (attendance sync, etc.)
# HRIS_SYSTEM_USERNAME=01.05.13.500
# HRIS_SYSTEM_PASSWORD=your-password-here

# Cache Configuration
# CACHE_BACKEND=inmemory
# CACHE_EXPIRE_SECONDS=60

# Feature complexity scoring / AI formula generation via Z.AI GLM Coding Plan.
# Set ZAI_API_KEY to enable LLM-based scoring; leave empty to use the built-in
# deterministic rules scorer. NEVER commit a real key.
# ZAI_API_KEY=<your-zai-api-key>
# ZAI_MODEL=glm-5.3
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
# ZAI_TIMEOUT_SECONDS=120
# ZAI_MAX_TOKENS=2500
# ZAI_MAX_ATTEMPTS=3

# Application Settings
APP_ENV=development
DEBUG=True